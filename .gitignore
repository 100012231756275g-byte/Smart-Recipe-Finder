const mockRecipes = [
  { name: "ผัดกะเพราอกไก่คลีน", img: "https://images.unsplash.com/photo-1548943487-a2e4b43b485d" },
  { name: "ต้มยำกุ้งน้ำใส", img: "https://images.unsplash.com/photo-1559847844-5315695dadae" },
