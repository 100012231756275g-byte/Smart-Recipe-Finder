];

async function seedDatabase() {
  console.log("🚀 เริ่มต้นสร้างข้อมูลจำลอง 30 ผู้ใช้ และสถิติภาพรวม...\n");

  let createdCount = 0;

  for (let i = 0; i < mockUsers.length; i++) {
    const u = mockUsers[i];
    let userId = null;

    try {
      const { data: authUser, error: authError } = await supabase.auth.admin.createUser({
        email: u.email,
        password: "Password@1234",
        email_confirm: true,
        user_metadata: { name: u.name },
      });

      if (authError) {
        const { data: existingUsers } = await supabase.auth.admin.listUsers();
        const found = existingUsers?.users?.find((ex) => ex.email === u.email);
        if (found) userId = found.id;
      } else {
        userId = authUser.user.id;
      }
    } catch (e) {
      // ดำเนินการต่อด้วย ID จำลองหาก auth ติดขัด
    }

    if (!userId) {
      userId = `mock-usr-${i + 1}-${Date.now().toString(36)}`;
    }

    const { error: profileError } = await supabase.from("profiles").upsert({
      id: userId,
      full_name: u.name,
      role: "user",
      age: u.age,
      bmi: u.bmi,
      health_issues: u.allergies !== "ไม่มี" ? u.allergies : null,
      diseases: u.diseases !== "ไม่มี" ? u.diseases : null,
      status: "active",
      contact_info: u.email,
      favorites_count: Math.floor(Math.random() * 6) + 1,
    });

    if (!profileError) createdCount++;
    process.stdout.write(`⏳ สร้างข้อมูลผู้ใช้สำเร็จ: ${i + 1}/${mockUsers.length}...\r`);
  }

  console.log(`\n✅ บันทึกข้อมูลผู้ใช้ 30 คนเรียบร้อย (${createdCount} รายการ)\n`);

  console.log("📊 กำลังจำลองสถิติการค้นหาย้อนหลัง 7 วัน...");
  const searchLogs = [];
  const now = new Date();

  for (let dayOffset = 6; dayOffset >= 0; dayOffset--) {
    const logsPerDay = [14, 18, 16, 25, 38, 42, 30][6 - dayOffset] || 15;
    for (let j = 0; j < logsPerDay; j++) {
      const logDate = new Date(now);
      logDate.setDate(now.getDate() - dayOffset);
      logDate.setHours(Math.floor(Math.random() * 14) + 8, Math.floor(Math.random() * 59));

      searchLogs.push({ created_at: logDate.toISOString() });
    }
  }

  const { error: searchErr } = await supabase.from("search_logs").insert(searchLogs);
  if (searchErr) {
    console.warn("⚠️ ตาราง search_logs ยังไม่มีในระบบ (ข้ามการบันทึก search logs)");
  } else {
    console.log(`✅ จำลองประวัติการค้นหาทั้งหมด ${searchLogs.length} ครั้ง เรียบร้อย!`);
  }

  console.log("⭐ กำลังจำลองการกดบันทึกเมนูโปรด (Favorites)...");
  const favorites = [];
  mockUsers.forEach((u) => {
    const favCount = Math.floor(Math.random() * 3) + 1;
    for (let f = 0; f < favCount; f++) {
      const recipe = mockRecipes[Math.floor(Math.random() * mockRecipes.length)];
      favorites.push({
        name: recipe.name,
        image_url: recipe.img,
        user_contact: u.email,
      });
    }
  });

  const { error: favErr } = await supabase.from("favorites").insert(favorites);
  if (favErr) {
    console.warn("⚠️ ตาราง favorites ยังไม่มีในระบบ (ข้ามการบันทึก favorites)");
  } else {
    console.log(`✅ จำลองเมนูโปรดทั้งหมด ${favorites.length} รายการ เรียบร้อย!`);
  }

  console.log("\n🎉 สำเร็จเรียบร้อย! ข้อมูล 30 ผู้ใช้งานถูกนำเข้าสู่ระบบแล้ว");
}

seedDatabase().catch(console.error);