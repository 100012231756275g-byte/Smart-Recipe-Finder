// seed.js
const fs = require("fs");
const path = require("path");
const { createClient } = require("@supabase/supabase-js");

// seed.js บรรทัดที่ 7-8
let supabaseUrl = "https://ivocnynysryvesrscdzr.supabase.co";


if (!supabaseUrl || !serviceRoleKey) {
  try {
    const envPath = path.resolve(process.cwd(), ".env.local");
    if (fs.existsSync(envPath)) {
      const envFile = fs.readFileSync(envPath, "utf-8");
      envFile.split("\n").forEach((line) => {
        const match = line.match(/^([^=]+)=(.*)$/);
        if (match) {
          const key = match[1].trim();
          const value = match[2].trim().replace(/^["']|["']$/g, "");
          if (key === "NEXT_PUBLIC_SUPABASE_URL") supabaseUrl = value;
          if (key === "SUPABASE_SERVICE_ROLE_KEY") serviceRoleKey = value;
        }
      });
    }
  } catch (err) {
    console.error("❌ อ่านไฟล์ .env.local ไม่สำเร็จ");
  }
}

if (!supabaseUrl || !serviceRoleKey) {
  console.error("🚨 กรุณาตรวจสอบว่ามี NEXT_PUBLIC_SUPABASE_URL และ SUPABASE_SERVICE_ROLE_KEY ใน .env.local");
  process.exit(1);
}

const supabase = createClient(supabaseUrl, serviceRoleKey, {
  auth: { autoRefreshToken: false, persistSession: false },
});

